rules_version = '2';
// Loja Dias: cada cliente só lê e grava os próprios dados. Ninguém lê dados de outro cliente.
service cloud.firestore {
  match /databases/{db}/documents {
    function dono(uid) { return request.auth != null && request.auth.uid == uid; }
    // pedidos_pagos: só a loja (robô com conta de serviço) grava. O cliente não cria nem muda.
    function pagosIntocado() { return resource == null ? !('pedidos_pagos' in request.resource.data)
      : (('pedidos_pagos' in resource.data) ? request.resource.data.get('pedidos_pagos', -1) == resource.data.pedidos_pagos : !('pedidos_pagos' in request.resource.data)); }
    match /clientes/{uid} {
      allow read: if dono(uid);
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'endereco', 'cidade', 'moto', 'km_dia', 'intervalo_oleo', 'lembrete', 'ultimas', 'pedidos_pagos', 'aceite', 'atualizado'])
        && pagosIntocado()
        && (!('moto' in request.resource.data) || (request.resource.data.moto is string && request.resource.data.moto.size() <= 60))
        && (!('km_dia' in request.resource.data) || (request.resource.data.km_dia is int && request.resource.data.km_dia >= 0 && request.resource.data.km_dia <= 1000))
        && (!('intervalo_oleo' in request.resource.data) || (request.resource.data.intervalo_oleo is int && request.resource.data.intervalo_oleo <= 10000))
        && (!('lembrete' in request.resource.data) || request.resource.data.lembrete is bool)
        && (!('ultimas' in request.resource.data) || (request.resource.data.ultimas is map && request.resource.data.ultimas.keys().hasOnly(['oleo', 'relacao', 'pastilha'])))
        && request.resource.data.aceite == 'v1'
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20
        && request.resource.data.endereco is string && request.resource.data.endereco.size() <= 200
        && request.resource.data.cidade is string && request.resource.data.cidade.size() <= 30;
      allow delete: if dono(uid);
      match /pedidos/{pid} {
        allow read: if dono(uid);
        allow create: if dono(uid)
          && request.resource.data.keys().hasOnly(['txid', 'total', 'cidade', 'itens', 'criado'])
          && request.resource.data.total is number && request.resource.data.total < 100000
          && request.resource.data.itens is list && request.resource.data.itens.size() <= 30
          && request.resource.data.criado == request.time;
        allow update: if false;  // histórico não muda
        allow delete: if dono(uid);  // LGPD: apagar minha conta
      }
    }
    match /{doc=**} { allow read, write: if false; }
  }
}
